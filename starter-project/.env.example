# Copy this file to `.env` before running the app:
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env

# Where the SQLite database file lives (relative to the prisma/ folder).
DATABASE_URL="file:./dev.db"

# Secret used to sign the login cookie. Any long random text works.
# Workshop only - never reuse this value in a real system.
AUTH_SECRET="workshop-dev-secret-change-me"

# hCaptcha keys (design §12c). These are hCaptcha's official TEST keys: the
# box shows but never asks for a puzzle, and the server always accepts the
# token - the full verification path (token required, server-checked, fail
# closed) still runs. For a real human check, create a free account at
# https://www.hcaptcha.com, set the site key's mode to "Always Challenge"
# and replace both values - no code change needed.
# HCAPTCHA_SECRET is server-only: never give it a NEXT_PUBLIC_ prefix.
HCAPTCHA_SITEKEY="10000000-ffff-ffff-ffff-000000000001"
HCAPTCHA_SECRET="0x0000000000000000000000000000000000000000"
