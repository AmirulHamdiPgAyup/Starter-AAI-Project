# Keep `npm install` output short and calm for the workshop.
# - fund/audit: hide the "looking for funding" and "vulnerabilities" messages.
#   The reported issues are in development tools (Prisma CLI, ESLint) that run
#   only on your laptop, and fixing them needs breaking upgrades.
# - loglevel=error: hide warnings such as "deprecated". Real errors still show.
fund=false
audit=false
loglevel=error
